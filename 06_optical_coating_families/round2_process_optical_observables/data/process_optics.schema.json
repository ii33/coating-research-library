    "film_state": {
      "type": "object",
      "properties": {
        "sample_id": {
          "type": "string",
          "minLength": 1
        },
        "state_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "stoichiometry": {
          "anyOf": [
            {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "Al",
                  "Si",
                  "O"
                ]
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "composition_complete": {
          "type": "boolean"
        },
        "constant_composition_density": {
          "type": "boolean"
        },
        "density_kg_m3": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "density_basis": {
          "enum": [
            "measured_film",
            "synthetic_film",
            "bulk",
            "qcm_setting",
            "unknown"
          ]
        },
        "measurement_temperature_K": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "history": {
          "type": "string",
          "minLength": 1
        }
