            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "temperature_range_K": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "parameters": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "A": {
                  "type": "number",
                  "minimum": 0
                },
                "B_um2": {
                  "type": "number",
                  "minimum": 0
                },
                "k": {
                  "type": "number",
                  "minimum": 0
