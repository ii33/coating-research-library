        "angle_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 89.8
        },
        "polarization": {
          "enum": [
            "s",
            "p",
            "unpolarized"
          ]
        },
        "bandpass_nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "offset_um": {
                "type": "number"
