            "diffuse_R_collection": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "diffuse_T_collection": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "geometry",
            "diffuse_R_collection",
            "diffuse_T_collection"
          ],
          "additionalProperties": false
        }
