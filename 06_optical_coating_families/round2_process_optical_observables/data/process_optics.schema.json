      "required": [
        "sample_id",
        "state_id",
        "stoichiometry",
        "composition_complete",
        "constant_composition_density",
        "density_kg_m3",
        "density_basis",
        "measurement_temperature_K",
        "history"
      ],
      "additionalProperties": false
    },
