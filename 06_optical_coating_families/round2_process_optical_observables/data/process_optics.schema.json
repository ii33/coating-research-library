{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_kind": {
      "enum": [
        "synthetic",
        "literature_conditioned",
        "unmeasured"
      ]
    },
    "exploratory_only": {
      "const": true
    },
    "design": {
      "type": "object",
      "properties": {
        "layer_thickness_um": {
          "type": "number",
          "minimum": 0
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "layer_thickness_um",
        "purpose"
      ],
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "properties": {
        "area_basis": {
          "const": "actual_workpiece_area"
        },
        "net_evidence": {
          "enum": [
            "synthetic_balance",
            "synthetic_direct",
            "measured_net",
            "unknown"
          ]
        },
        "initial_inventory_atoms_m2": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "Al",
              "Si",
              "O"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "qcm": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "sensor_mass_kg_m2": {
                  "type": "number",
                  "minimum": 0
                },
                "display_density_kg_m3": {
                  "type": "number",
                  "minimum": 0
                },
                "meaning": {
                  "const": "sensor_equivalent_not_workpiece_thickness"
                }
              },
              "required": [
                "sensor_mass_kg_m2",
                "display_density_kg_m3",
                "meaning"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "bins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              },
              "temperature_K": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "incident_atoms_m2_s": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "enum": [
                    "Al",
                    "Si",
                    "O"
                  ]
                },
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "net_atoms_m2_s": {
                "anyOf": [
                  {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                      "enum": [
                        "Al",
                        "Si",
                        "O"
                      ]
                    },
                    "additionalProperties": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "balance": {
                "anyOf": [
                  {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                      "enum": [
                        "Al",
                        "Si",
                        "O"
                      ]
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "retained_fraction": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 1
                        },
                        "reaction_gain_atoms_m2_s": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "desorption_atoms_m2_s": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "resputter_atoms_m2_s": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0
                        }
                      },
                      "required": [
                        "retained_fraction",
                        "reaction_gain_atoms_m2_s",
                        "desorption_atoms_m2_s",
                        "resputter_atoms_m2_s"
                      ],
                      "additionalProperties": false
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "start_s",
              "end_s",
              "temperature_K",
              "incident_atoms_m2_s",
              "net_atoms_m2_s",
              "balance"
